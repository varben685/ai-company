generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
model Project {
 id String @id @default(uuid()) @db.Uuid
 name String
 description String
 status String @default("ACTIVE")
 context Json
 contextVersion Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 tasks Task[]
}
model Task {
 id String @id @default(uuid()) @db.Uuid
 projectId String @db.Uuid
 project Project @relation(fields:[projectId],references:[id])
 title String
 description String
 priority String @default("NORMAL")
 priorityRank Int @default(3)
 status String @default("DRAFT")
 version Int @default(1)
 currentPlanId String? @db.Uuid
 approvedPlanId String? @db.Uuid
 activeRunId String? @db.Uuid
 failureCode String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 runs AgentRun[]
 plans TaskPlan[]
 approvals Approval[]
 @@unique([id,projectId])
 @@index([projectId,priorityRank,createdAt])
 @@index([status])
}
model AgentRun {
 id String @id @default(uuid()) @db.Uuid
 projectId String @db.Uuid
 taskId String @db.Uuid
 task Task @relation(fields:[taskId,projectId],references:[id,projectId])
 agentType String @default("PRODUCT")
 status String @default("QUEUED")
 provider String
 model String?
 promptVersion String
 inputSnapshot Json
 outputPlanId String? @db.Uuid
 startedAt DateTime?
 finishedAt DateTime?
 failureCode String?
 ownerToken String? @db.Uuid
 leaseUntil DateTime?
 attemptCount Int @default(0)
 nextAttemptAt DateTime @default(now())
 createdAt DateTime @default(now())
 attempts AgentRunAttempt[]
 plans TaskPlan[]
 outbox OutboxMessage[]
 @@unique([id,taskId,projectId])
 @@unique([id,projectId])
 @@index([status,nextAttemptAt])
}
model AgentRunAttempt {
 id String @id @default(uuid()) @db.Uuid
 projectId String @db.Uuid
 agentRunId String @db.Uuid
 run AgentRun @relation(fields:[agentRunId,projectId],references:[id,projectId])
 attemptNumber Int
 ownerToken String @unique @db.Uuid
 status String
 model String?
 startedAt DateTime @default(now())
 finishedAt DateTime?
 inputTokens Int?
 outputTokens Int?
 cachedInputTokens Int?
 estimatedCostUsd Decimal? @db.Decimal(20,8)
 pricingVersion String?
 providerRequestId String?
 errorCode String?
 @@unique([agentRunId,attemptNumber])
}
model TaskPlan {
 id String @id @default(uuid()) @db.Uuid
 projectId String @db.Uuid
 taskId String @db.Uuid
 task Task @relation(fields:[taskId,projectId],references:[id,projectId])
 versionNumber Int
 agentRunId String @unique @db.Uuid
 run AgentRun @relation(fields:[agentRunId,taskId,projectId],references:[id,taskId,projectId])
 schemaVersion String
 content Json
 contextVersion Int
 createdAt DateTime @default(now())
 approvals Approval[]
 @@unique([taskId,versionNumber])
 @@unique([id,taskId,projectId])
 @@unique([id,agentRunId,taskId,projectId])
}
model Approval {
 id String @id @default(uuid()) @db.Uuid
 projectId String @db.Uuid
 taskId String @db.Uuid
 task Task @relation(fields:[taskId,projectId],references:[id,projectId])
 type String @default("PLAN")
 targetPlanId String @db.Uuid
 plan TaskPlan @relation(fields:[targetPlanId,taskId,projectId],references:[id,taskId,projectId])
 status String @default("PENDING")
 decidedBy String?
 decidedAt DateTime?
 comment String?
 createdAt DateTime @default(now())
 @@unique([targetPlanId,type])
 @@index([status])
}
model Event {
 id String @id @default(uuid()) @db.Uuid
 projectId String @db.Uuid
 taskId String? @db.Uuid
 agentRunId String? @db.Uuid
 type String
 actorType String
 actorId String?
 correlationId String
 payload Json
 createdAt DateTime @default(now())
 @@index([taskId,createdAt])
}
model OutboxMessage {
 id String @id @default(uuid()) @db.Uuid
 projectId String @db.Uuid
 taskId String @db.Uuid
 agentRunId String @db.Uuid
 run AgentRun @relation(fields:[agentRunId,taskId,projectId],references:[id,taskId,projectId])
 kind String @default("PLAN_REQUESTED")
 payload Json
 status String @default("PENDING")
 attempts Int @default(0)
 nextAttemptAt DateTime @default(now())
 dispatchedAt DateTime?
 createdAt DateTime @default(now())
 @@unique([agentRunId,kind])
 @@index([status,nextAttemptAt])
}
model CommandReceipt {
 id String @id @default(uuid()) @db.Uuid
 key String
 operation String
 actorId String
 requestHash String
 resourceId String @db.Uuid
 response Json
 createdAt DateTime @default(now())
 @@unique([operation,actorId,key])
}
