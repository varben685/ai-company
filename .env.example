# Run pnpm setup:local to generate random local credentials in ignored files.
DATABASE_URL=postgresql://company:LOCAL_PASSWORD@127.0.0.1:55432/company
POSTGRES_PASSWORD=LOCAL_PASSWORD
REDIS_URL=redis://127.0.0.1:56379
OPERATOR_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
WEB_ORIGIN=http://127.0.0.1:3000
API_PORT=3001
PROVIDER=DEMO
OPENAI_PRODUCT_MODEL=gpt-4.1-mini
PLANNING_CONCURRENCY=1
ATTEMPT_TIMEOUT_MS=120000
LEASE_MS=30000
# Worker-only secrets go in .env.worker, never .env or NEXT_PUBLIC_*.
